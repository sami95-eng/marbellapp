# ============================================================
# Marbell'app — variables d'environnement (modèle)
# Copie ce fichier en `.env` et renseigne les vraies valeurs.
# `.env` est ignoré par git (ne jamais committer de secrets).
# ============================================================

# ── Supabase (client Expo — exposé dans le bundle) ──────────
# Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Base de données (serveur / Drizzle) ─────────────────────
# Connection string Postgres (Supabase → Project Settings → Database)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── Legacy Manus OAuth (optionnel) ──────────────────────────
# Conservé pour compatibilité, ignoré par le flux d'auth actuel.
# Laisser vide si non utilisé.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=

# ============================================================
# SECRETS EDGE FUNCTIONS (à définir dans Supabase, PAS ici)
# Dashboard → Edge Functions → Secrets :
#   RESEND_API_KEY            clé API Resend (envoi des emails)
#   FROM_EMAIL                expéditeur (domaine vérifié Resend)
#   ADMIN_EMAIL               destinataire des récaps admin
# (SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectés
#  automatiquement par Supabase dans les Edge Functions.)
# ============================================================
